[Unit]
Description=6mansdle API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sixmansdle
Group=sixmansdle
WorkingDirectory=/opt/6mansdle/app/repo/apps/api
EnvironmentFile=/opt/6mansdle/app/.env
# Leading "-" makes this optional: deploy.sh writes GIT_SHA here on every deploy, but the unit
# must still start fine (e.g. first-ever boot before deploy.sh has run) if the file is absent.
EnvironmentFile=-/opt/6mansdle/app/version
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/6mansdle/app/repo/node_modules/tsx/dist/cli.mjs src/index.ts
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/6mansdle/app
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
