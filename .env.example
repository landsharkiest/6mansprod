# ---- Server ----
NODE_ENV=development
PORT=3001
# Public URL of the frontend (used for OAuth redirects and CORS)
WEB_ORIGIN=http://localhost:5173
# Public URL of this API (used to build the Discord callback URL)
API_ORIGIN=http://localhost:3001

# ---- Database ----
# Never commit a real value. Rotate immediately if one ever lands in git.
DATABASE_URL=postgres://sixmansdb:CHANGE_ME@localhost:5432/sixmansdle
# Set to "true" for RDS (server certificate is not verified against a CA bundle).
DATABASE_SSL=false

# ---- Sessions ----
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=CHANGE_ME

# ---- Discord OAuth ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user ids that may approve/reject uploads
ADMIN_DISCORD_IDS=

# ---- S3 ----
AWS_REGION=us-east-1
S3_BUCKET=6mans-clip-bucket
# Credentials come from the standard AWS chain (env vars, ~/.aws, or the EC2 instance role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional CloudFront domain for serving approved clips; falls back to presigned S3 URLs.
# CDN_ORIGIN=https://dxxxx.cloudfront.net

# ---- Uploads ----
MAX_UPLOAD_MB=50
